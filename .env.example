# ─── Database (required in production) ───────────────────────────────────────
# Free Turso database: https://turso.tech  →  create DB  →  copy URL + token
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Optional: if not set, you create the password on first visit to /admin
ADMIN_PASSWORD=
# Optional but recommended: any long random string (signs login cookies)
AUTH_SECRET=

# ─── AI (set ONE) ────────────────────────────────────────────────────────────
# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# or Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ─── Image storage (optional — falls back to the database) ───────────────────
# Cloudinary (recommended, free tier, auto-resizing CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or Vercel Blob: create a Blob store in Vercel → token is added automatically
# BLOB_READ_WRITE_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────────
# Your final domain (used in WhatsApp messages, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=https://kavitasartistry.in
# Default WhatsApp number (can be changed anytime in Admin → Settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
