# Copy to .env.local for local development. Every value is optional:
# with nothing set, the app runs on a local file database (data/local.db) with demo products.

# Database (Turso). Leave empty locally to use the safe local file database.
# Filling these in locally edits the LIVE shop's data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Same as above; these two win if both are set (used when moving the database to a new region).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# AI (one is enough). Without a key, AI features fall back to simple keyword logic.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Photo uploads (optional). Without these, photos are stored in the database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOB_READ_WRITE_TOKEN=

# Optional
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_SITE_URL=
# Fixed admin password (otherwise it is created on first visit to /admin)
ADMIN_PASSWORD=
# Login-cookie signing secret (otherwise derived from the database token)
AUTH_SECRET=
