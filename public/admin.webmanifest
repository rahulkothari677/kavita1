{
  "id": "/admin",
  "name": "Kavita's Studio Admin",
  "short_name": "Studio Admin",
  "description": "Manage products, orders and the shop for Kavita's Artistry",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#14213f",
  "theme_color": "#3f2e22",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Orders", "url": "/admin/orders", "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }] },
    { "name": "Add a product", "url": "/admin/products/new", "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }] }
  ]
}
